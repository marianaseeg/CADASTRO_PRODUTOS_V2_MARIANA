{
  "version": 2,
  "builds": [
    {
      "src": "BACK-END/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "FRONT-END/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/BACKEND/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/FRONTEND/$1"
    }
  ]
}
